generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  PROVIDER
  PROVIDER_STAFF
}

enum OrderStatus{
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus{
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  role      UserRole @default(USER)
  addressId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address  Address[]
  provider        Provider?
  provider_member ProviderMember[]
  cart            Cart[]
  faviorate Faviorate[]
  order Order[]
  
}


model Address {
  id String @id @default(cuid())
  userId Int
  street String
  city String
  state String
  zip String
  country String
  user User @relation(fields: [userId], references: [id])
}


model Provider {
  id           String   @id @default(cuid())
  userId       Int      @unique
  businessName String
  description  String?
  status       String   @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  products Product[]
  members ProviderMember[]
  order   Order[]
  shipment Shipment[]
}

model ProviderMember {
  id        Int      @id @default(autoincrement())
  providerId String   
  userId    Int    
  role      String
  user      User     @relation(fields: [userId], references: [id])
  provider  Provider @relation(fields: [providerId], references: [id])
}


model Category{
  id  String @id @default(cuid())
  name String 
  slug String
  products Product[]
}

model Product{
  id String @id @default(cuid())
  name String
  description String
  price Float
  imageUrl String
  categoryId String
  providerId String?
  provider Provider? @relation(fields: [providerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  cartItem CartItem[]
  faviorate Faviorate[]
  orderItem OrderItem[]
  
}

model Cart{
  id String @id @default(cuid())
  userId Int
  user User @relation(fields: [userId], references: [id]) 
  items CartItem[]
}

model CartItem{
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields: [cartId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
}


model Faviorate{
  id String @id @default(cuid())
  userId Int
  productId String
  user User @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order{
  id String @id @default(cuid())
  userId Int
  providerId String
  address String
  status OrderStatus @default(PENDING)
  
  user User @relation(fields: [userId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  items   OrderItem[]
  shipment Shipment[]
}

model OrderItem{
  id String @id @default(cuid())
  orderId String
  productId String
  productDetail String
  quantity Int
  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Shipment {
  id String @id @default(cuid())
  orderId String
  providerId String
  trackingNumber String @unique()
  assignedMemberId String
  status ShipmentStatus @default(PENDING)
  startDate DateTime 
  endDate DateTime 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
}