generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  PROVIDER
  PROVIDER_STAFF
}

enum OrderStatus{
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCEL_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  REFUNDED
}

enum ShipmentStatus{
  PENDING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_IN_TRANSIT
  RETURNED
  REFUNDED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  role      UserRole @default(USER)
  addressId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address  Address[]
  provider        Provider?
  provider_member ProviderMember[]
  cart            Cart[]
  faviorate Faviorate[]
  order Order[]
  assignedShipments Shipment[] @relation("AssignedStaffShipments")
  shipmentLogs ShipmentLog[] @relation("StaffShipmentLogs")
}


model Address {
  id String @id @default(cuid())
  userId Int
  street String
  city String
  state String
  zip String
  country String
  user User @relation(fields: [userId], references: [id])
  order Order[]
}


model Provider {
  id           String   @id @default(cuid())
  userId       Int      @unique
  businessName String
  description  String?
  status       String   @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  products Product[]
  members ProviderMember[]
  order   Order[]
  shipment Shipment[]
}

model ProviderMember {
  id        Int      @id @default(autoincrement())
  providerId String   
  userId    Int    
  role      String   @default("PROVIDER_STAFF")
  user      User     @relation(fields: [userId], references: [id])
  provider  Provider @relation(fields: [providerId], references: [id])
}


model Category{
  id  String @id @default(cuid())
  name String 
  slug String
  products Product[]
}

model Product{
  id String @id @default(cuid())
  name String
  description String
  price Float   
  isPublished Boolean @default(false)
  slug String?
  imageUrl String
  categoryId String
  isApproved Boolean @default(false)
  providerId String?
  provider Provider? @relation(fields: [providerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  cartItem CartItem[]
  faviorate Faviorate[]
  orderItem OrderItem[]
  
}


model Cart{
  id String @id @default(cuid())
  userId Int
  user User @relation(fields: [userId], references: [id]) 
  items CartItem[]
}


model CartItem{
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields: [cartId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
}


model Faviorate{
  id String @id @default(cuid())
  userId Int
  productId String
  user User @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order{
  id String @id @default(cuid())
  userId Int
  providerId String
  addressDetail String?
  addressId String
  address Address @relation(fields:[addressId],references:[id]) 
  status OrderStatus @default(PENDING)
  returnReason String?
  
  user User @relation(fields: [userId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  items   OrderItem[]
  shipment Shipment[]
}

model OrderItem{
  id String @id @default(cuid())
  orderId String
  productId String
  productDetail String
  quantity Int
  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Shipment {
  id String @id @default(cuid())
  orderId String
  providerId String
  trackingNumber String @unique()
  carrier String? @default("Standard Ground")
  assignedMemberId String?
  assignedStaffId Int?
  assignedStaff User? @relation("AssignedStaffShipments", fields: [assignedStaffId], references: [id])
  status ShipmentStatus @default(PENDING)
  currentLocation String?
  startDate DateTime @default(now())
  endDate DateTime? 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  logs ShipmentLog[]
}

model ShipmentLog {
  id String @id @default(cuid())
  shipmentId String
  staffId Int?
  status ShipmentStatus
  location String?
  note String?
  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  staff User? @relation("StaffShipmentLogs", fields: [staffId], references: [id])
}